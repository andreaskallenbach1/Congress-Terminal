---
// "In this edition": each section with its reading time; bar length is reading time.
interface Item { href: string; label: string; minutes: number }
interface Props { items: Item[]; total: number }
const { items, total } = Astro.props;
const max = Math.max(...items.map((i) => i.minutes), 1);
---
<nav class="toc" aria-label="Contents of this edition">
  <h2>In this edition</h2>
  <ol>
    {items.map((i) => (
      <li>
        <a href={i.href}><span>{i.label}</span><span class="min">{Math.round(i.minutes)} min</span></a>
        <span class="bar" style={`width:${Math.max(8, (i.minutes / max) * 100)}%`} aria-hidden="true"></span>
      </li>
    ))}
  </ol>
  <p class="note">About {Math.round(total)} minutes in all. Bar length is reading time.<span class="aside-count"></span></p>
</nav>
<style>
  .toc { padding-top: 28px; }
  h2 { margin: 0 0 14px; font-size: 22px; font-weight: 800; font-stretch: 88%; }
  ol { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--ink); }
  li { padding: 10px 0 8px; border-bottom: 1px solid var(--rule); display: grid; gap: 6px; }
  a { display: flex; justify-content: space-between; gap: 10px; color: var(--ink); text-decoration-color: var(--rule); }
  .min { color: var(--ink-soft); font-variant-numeric: tabular-nums; text-decoration: none; }
  .bar { height: 3px; background: var(--ink-faint); }
  li:first-child .bar { background: var(--ink); }
  .note { margin: 14px 0 0; font-size: 14px; line-height: 1.45; color: var(--ink-soft); }
</style>
<script>
  try {
    const n = JSON.parse(localStorage.getItem('ct-set-aside') || '[]').length;
    const el = document.querySelector('.aside-count');
    if (el && n > 0) el.textContent = ` ${n} ${n === 1 ? 'story' : 'stories'} set aside for later.`;
  } catch {}
</script>
