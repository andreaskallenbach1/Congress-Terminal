---
// Where a bill stands (FT 5): stages from introduction to the President; setbacks drawn in red.
import { formatDay } from '../lib/editions';
interface Stage { key: string; label: string; date?: string; done: boolean; setback: boolean }
interface Props { bill: { number: string; title: string; congressGovUrl: string; stages: Stage[] } }
const { bill } = Astro.props;
---
<figure class="progress" aria-label={`Progress of ${bill.number}`}>
  <figcaption><a href={bill.congressGovUrl}>{bill.number}</a>, {bill.title}</figcaption>
  <ol>
    {bill.stages.map((s) => (
      <li class:list={[{ done: s.done, setback: s.setback }]}>
        <span class="dot" aria-hidden="true"></span>
        <span class="label">{s.label}{s.date && <>, {formatDay(s.date)}</>}</span>
        <span class="visually-hidden">{s.done ? 'completed' : 'not yet'}</span>
      </li>
    ))}
  </ol>
</figure>
<style>
  .progress { margin: 6px 0; font-family: var(--font-ui); }
  figcaption { font-size: 15px; font-weight: 700; margin-bottom: 12px; }
  ol { list-style: none; margin: 0; padding: 0; display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); }
  li { position: relative; padding-top: 22px; font-size: 14px; line-height: 1.3; color: var(--ink-soft); }
  li::before { content: ''; position: absolute; top: 7px; left: 7px; right: -7px; border-top: 2px dashed var(--rule); }
  li.done::before { border-top: 2px solid var(--accent); }
  li.setback::before { border-top: 2px dashed #B23A2E; }
  li:last-child::before { display: none; }
  .dot { position: absolute; top: 1px; left: 0; width: 14px; height: 14px; border-radius: 50%; background: var(--paper); border: 2px solid var(--rule); }
  .done .dot { background: var(--accent); border-color: var(--accent); }
  .setback .dot { background: #B23A2E; border-color: #B23A2E; border-radius: 2px; transform: rotate(45deg) scale(0.85); }
  .done .label { color: var(--ink); }
  .setback .label { color: #B23A2E; font-weight: 700; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  @media (max-width: 640px) {
    ol { grid-auto-flow: row; gap: 10px; }
    li { padding: 0 0 0 26px; }
    li::before { display: none; }
    .dot { top: 2px; }
  }
</style>
